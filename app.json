{
  "expo": {
    "name": "farolv3",
    "slug": "farolv3",
    "icon": "./assets/images/splash-new-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "farolv3",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.farolv3"
    },

    "web": {
      "bundler": "metro",
      "output": "static"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-new-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE"
        }
      ],
      "expo-font",
      "@rnmapbox/maps"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}