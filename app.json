{
  "expo": {
    "name": "Farol",
    "slug": "farolv3",
    "icon": "./assets/images/app-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "farolv3",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "br.com.farol.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#031E43",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#031E43"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#0969D7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Farol usa sua localização para posicionar o mapa onde você está ao registrar um relato de acidente."
        }
      ],
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0dcbef34-f1c0-41c9-bd8c-f0d6a1845c69"
      }
    },
    "owner": "lucazoz"
  }
}
