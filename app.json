{
  "expo": {
    "name": "farolv3",
    "slug": "farolv3",
    "icon": "./assets/images/app-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "farolv3",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
  "adaptiveIcon": {
    "foregroundImage": "./assets/images/app-icon.png",
    "backgroundColor": "#000000"
  },
  "softwareKeyboardLayoutMode": "pan",
  "predictiveBackGestureEnabled": false,
  "package": "com.anonymous.farolv3"
},

    "web": {
      "bundler": "metro",
      "output": "static"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#031E43",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#031E43"
          }
        }
      ],
      "expo-font",
      "expo-notifications",
      "@rnmapbox/maps"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}